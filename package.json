{
  "name": "@react-native-ohos/react-native-change-icon",
  "displayName": "react-native-change-icon",
  "version": "1.0.0-beta.1",
  "description": "Change application icon programmatically in React-Native.",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "react-native": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/xdxs/rntpc_react-native-change-icon.git"
  },
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos",
    "rnoh",
    "openharmony",
    "ohos"
  ],
  "homepage": "https://gitcode.com/xdxs/rntpc_react-native-change-icon",
  "bugs": {
    "url": "https://gitcode.com/xdxs/rntpc_react-native-change-icon/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist/",
    "src/",
    "harmony/",
    "README.md",
    "README_EN.md",
    "README_en.md",
    "CHANGELOG.md",
    "README.OpenSource",
    "COMMITTERS.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc --noEmit && bob build",
    "codegen-lib": "react-native codegen-harmony --cpp-output-path ./harmony/change_icon/src/main/cpp/generated --ets-output-path ./harmony/change_icon/src/main/ets/generated",
    "xts": "npm test --prefix xts"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@react-native/typescript-config": "0.79.5",
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "react-native-builder-bob": "^0.18.0",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-change-icon",
    "autolinking": {
      "cmakeLibraryTargetName": "change_icon",
      "ohPackageName": "@react-native-ohos/react-native-change-icon",
      "etsPackageClassName": "ChangeIconPackage",
      "cppPackageClassName": "ChangeIconPackage"
    },
    "codegenConfig": [
      {
        "version": 1,
        "specPaths": [
          "./src/specs/v1"
        ]
      }
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
